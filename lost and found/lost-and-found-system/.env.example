# Environment Configuration for Render.com

# Server Configuration
NODE_ENV=production
PORT=10000

# Security Keys (Render will auto-generate these)
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-key-here

# Frontend URL (Update this after deploying frontend)
FRONTEND_URL=https://your-frontend-url.onrender.com

# Database
DB_PATH=../database/lost_and_found.db

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://your-frontend-url.onrender.com,http://localhost:8000
